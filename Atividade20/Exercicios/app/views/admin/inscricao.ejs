<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscrição - Semana de Tecnologia</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="/">Semana de Tecnologia</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/sobre">Sobre</a></li>
          <li class="nav-item"><a class="nav-link" href="/programacao">Programação</a></li>
          <li class="nav-item"><a class="nav-link" href="/contato">Contato</a></li>
          <li class="nav-item"><a class="nav-link active" href="/admin/inscricao">Inscrição</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <section class="secao secao-alt">
    <div class="container">
      <h1 class="mb-3">Inscrição</h1>
      <p class="text-muted mb-4">Página em construção. Em breve você poderá se inscrever nas palestras e workshops por aqui.</p>

      <div class="card-info" style="max-width: 500px;">
        <div class="mb-3">
          <label class="form-label">Nome</label>
          <input type="text" class="form-control" name="nome">
        </div>

        <div class="mb-3">
          <label class="form-label">E-mail</label>
          <input type="email" class="form-control" name="email">
        </div>

        <div class="mb-3">
          <label class="form-label">Palestra/Workshop</label>
          <select class="form-select" name="evento">
            <option>Introdução à Inteligência Artificial</option>
            <option>Workshop de Node.js e Express</option>
            <option>Segurança da Informação na Prática</option>
          </select>
        </div>

        <button type="button" class="btn btn-destaque" style="background-color:#141414; border-color:#141414;" disabled>
          Inscrever (ainda não funcional)
        </button>
      </div>

      <a href="/" class="btn btn-outline-dark-custom mt-4">&larr; Voltar</a>
    </div>
  </section>

  <footer>
    <div class="container">
      <p class="mb-0">Semana de Tecnologia &mdash; 2025</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>